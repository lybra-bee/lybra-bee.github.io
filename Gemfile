source "https://rubygems.org"

# Версия Jekyll
gem "jekyll", "~> 4.3"

# Сама тема Chirpy
gem "jekyll-theme-chirpy"

# Плагины, которые требует тема и ваш конфиг
group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-redirect-from"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
  gem "jekyll-include-cache"
end
